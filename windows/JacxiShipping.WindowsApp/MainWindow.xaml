<Window x:Class="JacxiShipping.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JacxiShipping.WindowsApp.ViewModels;assembly=JacxiShipping.Core"
        xmlns:converters="clr-namespace:JacxiShipping.WindowsApp.Converters"
        mc:Ignorable="d"
        Title="JACXI Shipping — Admin Suite" 
        Height="860" 
        Width="1380"
        MinHeight="640" 
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource JacxiBackgroundBrush}"
        FontFamily="{StaticResource JacxiFontFamily}"
        KeyDown="MainWindow_KeyDown"
        SizeChanged="MainWindow_SizeChanged">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:PositiveIntToVisibilityConverter x:Key="PosIntToVis" />

        <!-- Vector Icon Path Style for Sidebar -->
        <Style x:Key="NavIconStyle" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Section Micro-Header Style -->
        <Style x:Key="NavGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="10,14,0,4" />
            <Setter Property="Visibility" Value="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- MAIN AUTHENTICATED ADMIN SHELL -->
        <Grid Visibility="{Binding IsAdminAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MINIMALIST RESPONSIVE SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource JacxiDarkShellBrush}"
                    BorderBrush="{StaticResource JacxiDarkShellBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="236" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="64" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Clean Brand Header -->
                    <Border Grid.Row="0" Padding="14,0" BorderBrush="{StaticResource JacxiDarkShellBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource JacxiGoldBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="JX" FontWeight="Bold" FontSize="14" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="JACXI" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource JacxiGoldBrush}" Margin="0,-2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clean Grouped Navigation with Vector Icons -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,10">
                        <StackPanel>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" ToolTip="Admin Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconDashboard}" />
                                    <TextBlock Text="Dashboard" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>

                            <!-- LOGISTICS -->
                            <TextBlock Text="LOGISTICS" Style="{StaticResource NavGroupHeader}" />
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Shipments" ToolTip="Shipments">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconBox}" />
                                        <TextBlock Text="Shipments" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                    <Border Background="{StaticResource JacxiWarningBgBrush}" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding Badges.AgingShipments, Converter={StaticResource PosIntToVis}}">
                                        <TextBlock Text="{Binding Badges.AgingShipments}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource JacxiWarningBrush}"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="OperationsBoard" ToolTip="Operations Board">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconBoard}" />
                                    <TextBlock Text="Operations Board" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Containers" ToolTip="Containers">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconContainer}" />
                                    <TextBlock Text="Containers" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Dispatches" ToolTip="Dispatches">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconTruck}" />
                                    <TextBlock Text="Dispatches" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Transits" ToolTip="Transits">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconRoute}" />
                                    <TextBlock Text="Transits" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="GatePasses" ToolTip="Gate Passes">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconClock}" />
                                        <TextBlock Text="Gate Passes" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                    <Border Background="{StaticResource JacxiGoldLightBrush}" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding Badges.PendingGatePasses, Converter={StaticResource PosIntToVis}}">
                                        <TextBlock Text="{Binding Badges.PendingGatePasses}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Inspections" ToolTip="Quality &amp; Photos">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconCamera}" />
                                    <TextBlock Text="Quality &amp; Photos" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Tracking" ToolTip="Live Tracking">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconGlobe}" />
                                    <TextBlock Text="Live Tracking" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="TrackingDiagnostics" ToolTip="AIS Diagnostics">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSignal}" />
                                    <TextBlock Text="AIS Diagnostics" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>

                            <!-- FINANCE (RBAC Gated) -->
                            <StackPanel Visibility="{Binding CanViewFinance, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="FINANCE" Style="{StaticResource NavGroupHeader}" />
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Finance" ToolTip="Finance &amp; Ledgers">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconFinance}" />
                                        <TextBlock Text="Finance &amp; Ledgers" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Banking" ToolTip="Banking &amp; CSV">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconBank}" />
                                        <TextBlock Text="Banking &amp; CSV" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Invoices" ToolTip="Invoices">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconInvoice}" />
                                            <TextBlock Text="Invoices" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                        </StackPanel>
                                        <Border Background="{StaticResource JacxiErrorBgBrush}" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding Badges.OverdueInvoices, Converter={StaticResource PosIntToVis}}">
                                            <TextBlock Text="{Binding Badges.OverdueInvoices}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource JacxiErrorBrush}"
                                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                        </Border>
                                    </Grid>
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="OfficeExpenses" ToolTip="Office Expenses">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconExpense}" />
                                        <TextBlock Text="Office Expenses" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="CompanyLedgers" ToolTip="Company Ledgers">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconBuilding}" />
                                        <TextBlock Text="Company Ledgers" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="PriceComparison" ToolTip="Carrier Rates &amp; FX">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconRates}" />
                                        <TextBlock Text="Rates &amp; FX" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- CUSTOMERS -->
                            <TextBlock Text="CUSTOMERS" Style="{StaticResource NavGroupHeader}" />
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Customers" ToolTip="Customers &amp; Users">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconUsers}" />
                                    <TextBlock Text="Customers &amp; Users" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="PartnerPortals" ToolTip="Partner Portals">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconShield}" />
                                    <TextBlock Text="Partner Portals" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Communications" ToolTip="Communications">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconChat}" />
                                    <TextBlock Text="Communications" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>

                            <!-- TOOLS & SYSTEM -->
                            <TextBlock Text="SYSTEM" Style="{StaticResource NavGroupHeader}" />
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Calculator" ToolTip="Rate Calculator">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconBolt}" />
                                    <TextBlock Text="Rate Calculator" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Documents" ToolTip="Documents &amp; PDFs">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconDoc}" />
                                    <TextBlock Text="Documents &amp; PDFs" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="AiCopilot" ToolTip="AI Copilot &amp; Voice">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSparkles}" />
                                    <TextBlock Text="AI Copilot" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Visibility="{Binding CanViewAnalytics, Converter={StaticResource BoolToVis}}" Command="{Binding NavigateCommand}" CommandParameter="Analytics" ToolTip="Analytics &amp; Charts">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconChart}" />
                                    <TextBlock Text="Analytics" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="Settings &amp; Sync">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSettings}" />
                                    <TextBlock Text="Settings &amp; Sync" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Clean Admin Footer -->
                    <Border Grid.Row="2" Padding="12,11" BorderBrush="{StaticResource JacxiDarkShellBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource JacxiDarkShellSubtleBrush}" BorderBrush="{StaticResource JacxiGoldBrush}" BorderThickness="1.2">
                                <TextBlock Text="{Binding CurrentAdmin.Initials}" Foreground="{StaticResource JacxiGoldBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="{Binding CurrentAdmin.Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentAdmin.RoleUpper}" Foreground="{StaticResource JacxiGoldBrush}" FontSize="9" FontWeight="Bold" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Lock" Command="{Binding SignOutCommand}" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="11" Cursor="Hand" Padding="6,4"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvBoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- TOP HEADER BAR & RESPONSIVE CONTENT HOST -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Minimalist Top Bar -->
                <Border Grid.Row="0" Background="{StaticResource JacxiPanelBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Sidebar Toggle + Clean Breadcrumb + Status Dot -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource JacxiGhostButton}" Command="{Binding ToggleSidebarCommand}" Padding="8" Margin="0,0,10,0" ToolTip="Toggle Sidebar">
                                <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconMenu}" Stroke="{StaticResource JacxiTextSecondaryBrush}" StrokeThickness="1.8" />
                            </Button>

                            <TextBlock Text="JACXI" FontSize="12.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text=" / " FontSize="12.5" Foreground="{StaticResource JacxiTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource JacxiTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                            <Border Background="{StaticResource JacxiSuccessBgBrush}" BorderBrush="{StaticResource JacxiSuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5.5" Height="5.5" Fill="{StaticResource JacxiSuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CloudStatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Search + Notifications + Copilot + Primary Action -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="GlobalSearchBox"
                                     Style="{StaticResource JacxiTextBox}"
                                     Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search VIN, tracking, container... (Ctrl+K)"
                                     Width="250"
                                     Height="34"
                                     Padding="10,6"
                                     Margin="0,0,8,0"
                                     KeyDown="GlobalSearchBox_KeyDown" />

                            <Button Style="{StaticResource JacxiOutlineButton}" Command="{Binding ToggleNotificationsCommand}" Padding="10,6" Margin="0,0,8,0" ToolTip="Notifications">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBell}" Stroke="{StaticResource JacxiTextPrimaryBrush}" StrokeThickness="1.7" />
                                    <Border Background="{StaticResource JacxiGoldBrush}" CornerRadius="7" Padding="5,0" Margin="6,0,0,0"
                                            Visibility="{Binding UnreadNotificationCount, Converter={StaticResource PosIntToVis}}">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" FontSize="9.5" FontWeight="Bold" Foreground="#111827" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource JacxiOutlineButton}" Command="{Binding ToggleCopilotDrawerCommand}" Padding="11,6" Margin="0,0,8,0" ToolTip="AI Copilot">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconSparkles}" Stroke="{StaticResource JacxiGoldActiveBrush}" StrokeThickness="1.7" Margin="0,0,6,0" />
                                    <TextBlock Text="Copilot" />
                                </StackPanel>
                            </Button>

                            <Button Content="+ New" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Shipments" Padding="14,7" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic Content & Drawers -->
                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding CurrentView}" />

                    <!-- Minimalist Notifications Drawer -->
                    <Border Width="330" HorizontalAlignment="Right" Background="{StaticResource JacxiPanelBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1,0,0,0" Padding="18"
                            Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVis}}"
                            Effect="{StaticResource JacxiCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="Mark read" Style="{StaticResource JacxiGhostButton}" Command="{Binding MarkNotificationsReadCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="11" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{StaticResource JacxiTextMutedBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="Close" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ToggleNotificationsCommand}" Margin="0,12,0,0" />
                        </Grid>
                    </Border>

                    <!-- Minimalist AI Copilot Drawer -->
                    <Border Width="360" HorizontalAlignment="Right" Background="{StaticResource JacxiPanelBrush}" BorderBrush="{StaticResource JacxiGoldBrush}" BorderThickness="1,0,0,0" Padding="18"
                            Visibility="{Binding IsCopilotDrawerOpen, Converter={StaticResource BoolToVis}}"
                            Effect="{StaticResource JacxiCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconSparkles}" Stroke="{StaticResource JacxiGoldActiveBrush}" StrokeThickness="1.8" Margin="0,0,8,0" />
                                    <TextBlock Text="JACXI Copilot" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Content="Close" Style="{StaticResource JacxiGhostButton}" Command="{Binding ToggleCopilotDrawerCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="11" />
                            </Grid>
                            <StackPanel Grid.Row="1">
                                <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding AiCopilotVM.PromptInput, UpdateSourceTrigger=PropertyChanged}" Tag="Ask about overdue invoices, containers..." Height="38" Margin="0,0,0,8" />
                                <Button Content="Ask Copilot" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding AiCopilotVM.AskCopilotCommand}" Margin="0,0,0,12" />
                                <Border Background="{StaticResource JacxiDarkShellBrush}" CornerRadius="10" Padding="14">
                                    <TextBlock Text="{Binding AiCopilotVM.LatestAnswer}" FontSize="12" Foreground="#E5E7EB" TextWrapping="Wrap" LineHeight="18" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Row="2" Content="Open AI &amp; Voice Console →" Style="{StaticResource JacxiOutlineButton}" Command="{Binding NavigateCommand}" CommandParameter="AiCopilot" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- CLEAN LOCK / SIGN-IN OVERLAY -->
        <Grid Background="{StaticResource JacxiDarkShellBrush}" Visibility="{Binding IsAdminAuthenticated, Converter={StaticResource InvBoolToVis}}">
            <Border Style="{StaticResource JacxiCardBorder}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource JacxiGoldBrush}" Margin="0,0,12,0">
                            <TextBlock Text="JX" FontWeight="Bold" FontSize="16" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="JACXI SHIPPING" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="ADMIN ACCESS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Admin Email" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding LoginEmail}" Tag="admin@jacxishipping.com" Height="38" Margin="0,0,0,12" />

                    <TextBlock Text="8-Character Login Code" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding LoginCodeInput}" Tag="e.g. JX884910" Height="38" Margin="0,0,0,18" />

                    <Button Content="Unlock Admin Suite" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding SignInLocalCommand}" Height="42" />
                    <TextBlock Text="{Binding LoginStatus}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
