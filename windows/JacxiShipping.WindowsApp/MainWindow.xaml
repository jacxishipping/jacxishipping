<Window x:Class="JacxiShipping.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JacxiShipping.WindowsApp.ViewModels;assembly=JacxiShipping.Core"
        xmlns:converters="clr-namespace:JacxiShipping.WindowsApp.Converters"
        mc:Ignorable="d"
        Title="JACXI Shipping — Enterprise Admin Suite v3.0" 
        Height="900" 
        Width="1460"
        MinHeight="740" 
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource JacxiBackgroundBrush}"
        FontFamily="{StaticResource JacxiFontFamily}"
        KeyDown="MainWindow_KeyDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- MAIN AUTHENTICATED ADMIN SHELL -->
        <Grid Visibility="{Binding IsAdminAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT GROUPED ADMIN SIDEBAR (24 Modules) -->
            <Border Grid.Column="0"
                    Background="{StaticResource JacxiDarkShellBrush}"
                    BorderBrush="{StaticResource JacxiDarkShellBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <Border Grid.Row="0" Padding="20,18,20,14" BorderBrush="{StaticResource JacxiDarkShellBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource JacxiGoldBrush}" Margin="0,0,12,0">
                                <TextBlock Text="JX" FontWeight="Bold" FontSize="15" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="JACXI" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="ENTERPRISE ADMIN v3" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource JacxiGoldBrush}" Margin="0,-2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Grouped Scrollable Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,10,10,10">
                        <StackPanel>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                                <TextBlock Text="⊞  Admin Dashboard" />
                            </RadioButton>

                            <!-- SHIPMENTS & LOGISTICS -->
                            <TextBlock Text="SHIPMENTS &amp; LOGISTICS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="8,12,0,4" />
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Shipments">
                                <Grid Width="200">
                                    <TextBlock Text="📦  Shipments" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource JacxiWarningBgBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badges.AgingShipments}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiWarningBrush}" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="OperationsBoard">
                                <TextBlock Text="⇄  Operations Board" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Containers">
                                <TextBlock Text="📥  Containers" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Dispatches">
                                <TextBlock Text="🚚  Dispatches" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Transits">
                                <TextBlock Text="🛣  Transits" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="GatePasses">
                                <Grid Width="200">
                                    <TextBlock Text="⏱  Company Gatepasses" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource JacxiGoldLightBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badges.PendingGatePasses}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Inspections">
                                <TextBlock Text="📷  Quality &amp; Photos" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Tracking">
                                <TextBlock Text="🌐  Track Shipments" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="TrackingDiagnostics">
                                <TextBlock Text="🛰  Tracking Diagnostics" />
                            </RadioButton>

                            <!-- FINANCE & ACCOUNTING (RBAC Gated) -->
                            <StackPanel Visibility="{Binding CanViewFinance, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="FINANCE &amp; ACCOUNTING" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="8,12,0,4" />
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Finance">
                                    <TextBlock Text="🏛  Finance &amp; Ledgers" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Banking">
                                    <TextBlock Text="🏦  Banking &amp; CSV Match" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Invoices">
                                    <Grid Width="200">
                                        <TextBlock Text="🧾  Invoices" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource JacxiErrorBgBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badges.OverdueInvoices}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiErrorBrush}" />
                                        </Border>
                                    </Grid>
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="OfficeExpenses">
                                    <TextBlock Text="💳  Office Expenses" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="CompanyLedgers">
                                    <TextBlock Text="🏢  Company Ledgers" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="PriceComparison">
                                    <TextBlock Text="💱  Carrier Rates &amp; FX" />
                                </RadioButton>
                            </StackPanel>

                            <!-- CUSTOMERS & PORTALS -->
                            <TextBlock Text="CUSTOMERS &amp; PORTALS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="8,12,0,4" />
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Customers">
                                <TextBlock Text="👥  Customers &amp; Users" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="PartnerPortals">
                                <TextBlock Text="🛡  Partner Portals" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Communications">
                                <TextBlock Text="💬  Comms Dispatch" />
                            </RadioButton>

                            <!-- TOOLS, AI & SYSTEM -->
                            <TextBlock Text="TOOLS, AI &amp; SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="8,12,0,4" />
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Calculator">
                                <TextBlock Text="⚡  Rate Calculator" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Documents">
                                <TextBlock Text="📄  Documents &amp; PDFs" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="AiCopilot">
                                <TextBlock Text="🤖  AI Copilot &amp; Voice" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Visibility="{Binding CanViewAnalytics, Converter={StaticResource BoolToVis}}" Command="{Binding NavigateCommand}" CommandParameter="Analytics">
                                <TextBlock Text="📊  Analytics &amp; Charts" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource JacxiNavButton}" GroupName="NavMenu" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <TextBlock Text="⚙  Cloud Sync &amp; Updates" />
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Admin Profile & Lock Button -->
                    <Border Grid.Row="2" Padding="14,12" BorderBrush="{StaticResource JacxiDarkShellBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource JacxiDarkShellSubtleBrush}" BorderBrush="{StaticResource JacxiGoldBrush}" BorderThickness="1.5" Margin="0,0,10,0">
                                <TextBlock Text="{Binding CurrentAdmin.Initials}" Foreground="{StaticResource JacxiGoldBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentAdmin.Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentAdmin.RoleUpper}" Foreground="{StaticResource JacxiGoldBrush}" FontSize="9" FontWeight="Bold" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Lock" Command="{Binding SignOutCommand}" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="11" Cursor="Hand" Padding="6,4" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- TOP ADMIN BAR, CONTENT HOST, AND RIGHT DRAWERS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="{StaticResource JacxiPanelBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status Badge -->
                        <Border Grid.Column="0" Background="{StaticResource JacxiSuccessBgBrush}" BorderBrush="{StaticResource JacxiSuccessBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource JacxiSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CloudStatusLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiSuccessBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Global Admin Search (Ctrl+K) -->
                        <Grid Grid.Column="1" MaxWidth="440" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="GlobalSearchBox" Grid.Column="0" Style="{StaticResource JacxiTextBox}" Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,6" />
                            <Button Grid.Column="1" Content="Search (Ctrl+K)" Style="{StaticResource JacxiOutlineButton}" Command="{Binding GlobalSearchCommand}" Padding="10,5" Margin="6,0,0,0" Height="34" FontSize="11" />
                        </Grid>

                        <!-- Quick Actions + Notification Bell + Copilot Drawer -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding UnreadNotificationCount, StringFormat='🔔 ({0})'}"
                                    Style="{StaticResource JacxiOutlineButton}"
                                    Command="{Binding ToggleNotificationsCommand}"
                                    Padding="10,6" Margin="0,0,8,0" />
                            <Button Content="🤖 AI Copilot"
                                    Style="{StaticResource JacxiOutlineButton}"
                                    Command="{Binding ToggleCopilotDrawerCommand}"
                                    Padding="10,6" Margin="0,0,8,0" />
                            <Button Content="Operations Board" Style="{StaticResource JacxiOutlineButton}" Command="{Binding NavigateCommand}" CommandParameter="OperationsBoard" Padding="10,6" Margin="0,0,8,0" />
                            <Button Content="+ New Shipment" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Shipments" Padding="12,6" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic Active View + Optional Overlay Drawers -->
                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding CurrentView}" />

                    <!-- Slide-Over Notifications Drawer -->
                    <Border Width="340" HorizontalAlignment="Right" Background="{StaticResource JacxiPanelBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1,0,0,0" Padding="18"
                            Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVis}}"
                            Effect="{StaticResource JacxiCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="NOTIFICATIONS" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Content="Mark All Read" Style="{StaticResource JacxiGhostButton}" Command="{Binding MarkNotificationsReadCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="11" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{StaticResource JacxiTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="Close Drawer" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ToggleNotificationsCommand}" Margin="0,10,0,0" />
                        </Grid>
                    </Border>

                    <!-- Slide-Over Admin AI Copilot Drawer -->
                    <Border Width="370" HorizontalAlignment="Right" Background="{StaticResource JacxiPanelBrush}" BorderBrush="{StaticResource JacxiGoldBrush}" BorderThickness="1.5,0,0,0" Padding="18"
                            Visibility="{Binding IsCopilotDrawerOpen, Converter={StaticResource BoolToVis}}"
                            Effect="{StaticResource JacxiCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="🤖 JACXI ADMIN COPILOT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" VerticalAlignment="Center" />
                                <Button Content="Close" Style="{StaticResource JacxiGhostButton}" Command="{Binding ToggleCopilotDrawerCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="11" />
                            </Grid>
                            <StackPanel Grid.Row="1">
                                <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding AiCopilotVM.PromptInput, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,0,8" />
                                <Button Content="Ask Copilot" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding AiCopilotVM.AskCopilotCommand}" Margin="0,0,0,12" />
                                <Border Background="{StaticResource JacxiDarkShellBrush}" CornerRadius="8" Padding="12">
                                    <TextBlock Text="{Binding AiCopilotVM.LatestAnswer}" FontSize="12" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Row="2" Content="Open Full AI &amp; Voice Console →" Style="{StaticResource JacxiOutlineButton}" Command="{Binding NavigateCommand}" CommandParameter="AiCopilot" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- LOCK / ADMIN SIGN-IN OVERLAY -->
        <Grid Background="{StaticResource JacxiDarkShellBrush}" Visibility="{Binding IsAdminAuthenticated, Converter={StaticResource InvBoolToVis}}">
            <Border Style="{StaticResource JacxiCardBorder}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource JacxiGoldBrush}" Margin="0,0,12,0">
                            <TextBlock Text="JX" FontWeight="Bold" FontSize="18" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="JACXI SHIPPING" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="ADMIN OPERATIONS ACCESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Admin Email" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding LoginEmail}" Height="38" Margin="0,0,0,12" />

                    <TextBlock Text="8-Character Login Code" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding LoginCodeInput}" Height="38" Margin="0,0,0,18" />

                    <Button Content="Unlock Admin Suite" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding SignInLocalCommand}" Height="42" />
                    <TextBlock Text="{Binding LoginStatus}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
