<Window x:Class="JacxiShipping.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JacxiShipping.WindowsApp.ViewModels;assembly=JacxiShipping.Core"
        mc:Ignorable="d"
        Title="JACXI Shipping - Logistics Operations Suite" 
        Height="840" 
        Width="1320"
        MinHeight="700" 
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource JacxiBackgroundBrush}"
        FontFamily="{StaticResource JacxiFontFamily}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Sidebar -->
            <ColumnDefinition Width="250" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LEFT SIDEBAR                                                      -->
        <!-- ================================================================= -->
        <Border Grid.Column="0"
                Background="{StaticResource JacxiDarkShellBrush}"
                BorderBrush="{StaticResource JacxiDarkShellBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="{StaticResource JacxiDarkShellBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Gold Logo Mark Icon -->
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="8"
                                    Background="{StaticResource JacxiGoldBrush}"
                                    Margin="0,0,12,0">
                                <TextBlock Text="JX"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="#111827"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="JACXI"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="SHIPPING"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiGoldBrush}"
                                           Margin="0,-2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="LOGISTICS OPERATIONS SUITE"
                                   FontFamily="{StaticResource JacxiFontFamily}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#9CA3AF"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,16,14,16">
                    <StackPanel>
                        <TextBlock Text="MAIN NAVIGATION"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#6B7280"
                                   Margin="8,0,0,10" />

                        <!-- Dashboard Tab -->
                        <RadioButton Style="{StaticResource JacxiNavButton}"
                                     GroupName="NavMenu"
                                     IsChecked="True"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Operations Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Shipments Tab -->
                        <RadioButton Style="{StaticResource JacxiNavButton}"
                                     GroupName="NavMenu"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Shipments">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Shipments &amp; Cargo" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Rate Calculator Tab -->
                        <RadioButton Style="{StaticResource JacxiNavButton}"
                                     GroupName="NavMenu"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Calculator">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Rate Calculator" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Live Tracking Tab -->
                        <RadioButton Style="{StaticResource JacxiNavButton}"
                                     GroupName="NavMenu"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Tracking">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Live Tracking" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Document Center Tab -->
                        <RadioButton Style="{StaticResource JacxiNavButton}"
                                     GroupName="NavMenu"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Document Center" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Background="{StaticResource JacxiDarkShellBorderBrush}" Margin="8,16,8,16" />

                        <TextBlock Text="DESTINATION HUBS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#6B7280"
                                   Margin="8,0,0,10" />

                        <TextBlock Text="● Mersin Yard (TR)" FontSize="11" Foreground="#9CA3AF" Margin="10,0,0,6" />
                        <TextBlock Text="● Jebel Ali Free Zone (UAE)" FontSize="11" Foreground="#9CA3AF" Margin="10,0,0,6" />
                        <TextBlock Text="● Poti Black Sea (GE)" FontSize="11" Foreground="#9CA3AF" Margin="10,0,0,6" />
                        <TextBlock Text="● Islam Qala Terminal (AFG)" FontSize="11" Foreground="#9CA3AF" Margin="10,0,0,6" />
                        <TextBlock Text="● Hairatan Inland Port (AFG)" FontSize="11" Foreground="#9CA3AF" Margin="10,0,0,6" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer User Profile & Build Version -->
                <Border Grid.Row="2"
                        Padding="16,16"
                        BorderBrush="{StaticResource JacxiDarkShellBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="{StaticResource JacxiDarkShellSubtleBrush}"
                                BorderBrush="{StaticResource JacxiGoldBrush}"
                                BorderThickness="1.5"
                                Margin="0,0,12,0">
                            <TextBlock Text="JX"
                                       Foreground="{StaticResource JacxiGoldBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Operations Desk"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="v1.0.0 Windows (x64)"
                                       Foreground="#9CA3AF"
                                       FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- TOP APP BAR & ACTIVE CONTENT HOST                                 -->
        <!-- ================================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Navigation & Action Bar -->
                <RowDefinition Height="58" />
                <!-- Dynamic Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource JacxiPanelBrush}"
                    BorderBrush="{StaticResource JacxiBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- System Status Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource JacxiSuccessBgBrush}"
                                BorderBrush="{StaticResource JacxiSuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,4"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource JacxiSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="JACXI CLOUD CONNECTED"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource JacxiSuccessBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Official Enterprise Desktop Client • Standard Port Rates 2026"
                                   FontSize="12"
                                   Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Header Quick Nav Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Quick Rate"
                                Style="{StaticResource JacxiOutlineButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Calculator"
                                Padding="12,6"
                                Margin="0,0,10,0" />
                        <Button Content="Track Cargo"
                                Style="{StaticResource JacxiPrimaryButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Tracking"
                                Padding="14,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Body View (mapped via DataTemplates in App.xaml) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
