    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>JacxiShipping</AssemblyName>
    <RootNamespace>JacxiShipping.WindowsApp</RootNamespace>
