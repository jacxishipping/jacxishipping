    <FileVersion>3.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JacxiShipping.Core\JacxiShipping.Core.csproj" />
  </ItemGroup>

</Project>
