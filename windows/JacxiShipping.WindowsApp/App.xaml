<Application x:Class="JacxiShipping.WindowsApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JacxiShipping.WindowsApp"
             xmlns:vm="clr-namespace:JacxiShipping.WindowsApp.ViewModels;assembly=JacxiShipping.Core"
             xmlns:views="clr-namespace:JacxiShipping.WindowsApp.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/JacxiDesignTokens.xaml" />
                <ResourceDictionary Source="Themes/JacxiControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MVVM View-ViewModel mappings -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShipmentsViewModel}">
                <views:ShipmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalculatorViewModel}">
                <views:CalculatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrackingViewModel}">
                <views:TrackingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
                <views:DocumentsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
