<UserControl x:Class="JacxiShipping.WindowsApp.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1120">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <!-- Header Card -->
            <Border Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="62" Height="62" CornerRadius="31" Background="{StaticResource JacxiDarkShellBrush}" BorderBrush="{StaticResource JacxiGoldBrush}" BorderThickness="2" Margin="0,0,18,0">
                        <TextBlock Text="{Binding Initials}" Foreground="{StaticResource JacxiGoldBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                        <TextBlock Text="{Binding Email}" FontSize="12.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,2,0,4" />
                        <Border Background="{StaticResource JacxiGoldLightBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="QUICK ACCESS CODE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock Text="{Binding LoginCode}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                            </Border>
                            <Button Content="Copy" Style="{StaticResource JacxiOutlineButton}" Command="{Binding CopyLoginCodeCommand}" Margin="0,0,6,0" />
                            <Button Content="Rotate" Style="{StaticResource JacxiOutlineButton}" Command="{Binding RegenerateLoginCodeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Details + Security -->
            <controls:ResponsiveColumnsPanel MaxColumns="2" MinColumnWidth="420" ColumnGap="20" RowGap="20">
                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="CONTACT &amp; OFFICE PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Full Name" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10" />

                        <TextBlock Text="Phone Number" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10" />

                        <TextBlock Text="Street Address" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Country" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Save Profile Changes" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding SaveProfileCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT PASSWORD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Current Password" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10" />

                        <TextBlock Text="New Password" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10" />

                        <TextBlock Text="Confirm New Password" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14" />

                        <Button Content="Update Password" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ChangePasswordCommand}" />
                    </StackPanel>
                </Border>
            </controls:ResponsiveColumnsPanel>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
