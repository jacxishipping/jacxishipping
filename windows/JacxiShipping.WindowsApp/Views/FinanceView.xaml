<UserControl x:Class="JacxiShipping.WindowsApp.Views.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1120">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Finance &amp; Customer Ledgers" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Monitor receivables, customer running balances, and post debit/credit ledger entries." FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Export Excel Ledger (.xlsx)" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ExportLedgerExcelCommand}" />
                </StackPanel>
            </Grid>

            <!-- Financial KPIs -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:StatsCard Grid.Column="0" Title="PENDING RECEIVABLES" Value="{Binding Stats.PendingInvoicesFormatted}" Subtitle="Open customer invoices" />
                <controls:StatsCard Grid.Column="1" Title="COLLECTED REVENUE" Value="{Binding Stats.CollectedRevenueFormatted}" Subtitle="Posted payments" />
                <controls:StatsCard Grid.Column="2" Title="OFFICE OPEX" Value="{Binding Stats.OfficeExpensesFormatted}" Subtitle="Monthly operating expenses" />
                <controls:StatsCard Grid.Column="3" Title="ESTIMATED NET PROFIT" Value="{Binding Stats.GrossProfitFormatted}" Subtitle="Margin after OpEx" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>

                <!-- Left: Customer Balances + Post Entry -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="CUSTOMER BALANCES (SELECT TO POST ENTRY)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding CustomerBalances}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Height="220"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                                      Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                                      ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding CollectionStatus}" Width="115" />
                                    <DataGridTextColumn Header="BALANCE DUE" Binding="{Binding BalanceFormatted}" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Post Ledger Entry Form -->
                    <Border Style="{StaticResource JacxiCardBorder}">
                        <StackPanel>
                            <TextBlock Text="POST MANUAL LEDGER ENTRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SelectedCustomer.Name, StringFormat='Account: {0}'}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <TextBlock Text="Description" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding EntryDescription}" Height="36" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Amount ($)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding EntryAmount}" Height="36" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Credit (Payment Received)" IsChecked="{Binding IsCredit}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </Grid>

                            <Button Content="Post to Customer Ledger" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding PostLedgerEntryCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Ledger Transaction Log -->
                <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="GENERAL LEDGER ENTRIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="16,16,16,10" />
                        <DataGrid ItemsSource="{Binding LedgerEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                                  Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding TransactionDate}" Width="95" />
                                <DataGridTextColumn Header="ACCOUNT" Binding="{Binding CustomerName}" Width="140" />
                                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountFormatted}" Width="95" />
                                <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceFormatted}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
