<Window x:Class="JacxiShipping.WindowsApp.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{StaticResource JacxiPanelBrush}"
            BorderBrush="{StaticResource JacxiBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24"
            Margin="16"
            Effect="{StaticResource JacxiCardShadow}">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource JacxiTextPrimaryBrush}" />
            <TextBlock x:Name="MessageText"
                       FontSize="12.5"
                       Foreground="{StaticResource JacxiTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource JacxiOutlineButton}"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" />
                <Button x:Name="ConfirmButton"
                        Content="Confirm"
                        Style="{StaticResource JacxiPrimaryButton}"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
