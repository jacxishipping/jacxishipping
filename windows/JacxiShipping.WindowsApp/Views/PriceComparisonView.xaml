<UserControl x:Class="JacxiShipping.WindowsApp.Views.PriceComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1120">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Carrier Price Comparison &amp; Multi-Currency FX" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Compare ocean line tariffs side-by-side and manage daily exchange rate snapshots for invoicing." FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

                <!-- Carrier Price Comparison Table -->
                <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,20,0" Padding="0">
                    <StackPanel>
                        <TextBlock Text="OCEAN LINE TARIFF COMPARISON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="16,14,16,10" />
                        <DataGrid ItemsSource="{Binding CarrierQuotes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                                  Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CARRIER" Binding="{Binding CarrierName}" Width="*" />
                                <DataGridTextColumn Header="CORRIDOR" Binding="{Binding Route}" Width="*" />
                                <DataGridTextColumn Header="DAYS" Binding="{Binding TransitDays}" Width="65" />
                                <DataGridTextColumn Header="RELIABILITY" Binding="{Binding ReliabilityScore}" Width="90" />
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFormatted}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Multi-Currency FX Rates -->
                <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="EXCHANGE RATES (BASE: USD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding ExchangeRates}" SelectedItem="{Binding SelectedRate, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Height="230"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                                  Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CODE" Binding="{Binding Currency}" Width="70" />
                                <DataGridTextColumn Header="RATE" Binding="{Binding RateDisplay}" Width="*" />
                                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="115" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding SelectedRate.Currency, StringFormat='Update {0} Rate (per 1 USD)'}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource JacxiTextBox}" Text="{Binding EditedRateValue}" Height="36" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Update FX" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding UpdateRateCommand}" Height="36" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
