<UserControl x:Class="JacxiShipping.WindowsApp.Views.McpServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1120">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MCP AI Gateway" FontSize="22" FontWeight="Bold" Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                    <TextBlock Text="Model Context Protocol server exposing JACXI operations tools &amp; OpenAPI specs to AI clients." FontSize="12.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sync Live Cloud" Style="{StaticResource JacxiOutlineButton}" Command="{Binding SyncFromCloudCommand}" Margin="0,0,8,0" />
                    <Button Content="Toggle Gateway" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding ToggleEnabledCommand}" />
                </StackPanel>
            </Grid>

            <!-- Summary Cards -->
            <controls:ResponsiveColumnsPanel MaxColumns="4" MinColumnWidth="210" ColumnGap="16" RowGap="16" Margin="0,0,0,20">
                <controls:StatsCard Title="Server" Value="{Binding Config.ServerName}" Subtitle="{Binding Config.ProtocolVersion}" />
                <controls:StatsCard Title="Auth Mode" Value="{Binding Config.AuthMode}" Subtitle="{Binding Config.DataSource}" />
                <controls:StatsCard Title="Tools Registered" Value="{Binding Tools.Count}" Subtitle="MCP JSON-RPC 2.0" />
                <controls:StatsCard Title="Resources" Value="{Binding Resources.Count}" Subtitle="URI manifests ready" />
            </controls:ResponsiveColumnsPanel>

            <!-- Connection & Credentials Card -->
            <Border Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,20">
                <controls:ResponsiveColumnsPanel MaxColumns="2" MinColumnWidth="400" ColumnGap="20" RowGap="16">
                    <StackPanel>
                        <TextBlock Text="ENDPOINT URL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Config.EndpointUrl}" Height="36" Margin="0,0,8,0" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource JacxiOutlineButton}" Command="{Binding CopyEndpointCommand}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="MCP BEARER API KEY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Config.ApiKey}" Height="36" Margin="0,0,8,0" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource JacxiOutlineButton}" Command="{Binding CopyApiKeyCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Rotate Key" Style="{StaticResource JacxiOutlineButton}" Command="{Binding RegenerateKeyCommand}" />
                        </Grid>
                    </StackPanel>
                </controls:ResponsiveColumnsPanel>
            </Border>

            <!-- Interactive Tool Runner -->
            <controls:ResponsiveColumnsPanel MaxColumns="2" MinColumnWidth="420" ColumnGap="20" RowGap="20" Margin="0,0,0,20">
                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="REGISTERED MCP TOOLS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,0,0,12" />
                        <ListView ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" BorderThickness="0" Background="Transparent" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                                <Border Background="{StaticResource JacxiGoldLightBrush}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="TEST TOOL RUNNER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Selected Tool Arguments (JSON)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding ToolArgsInput, UpdateSourceTrigger=PropertyChanged}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="Execute MCP Tool" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding RunToolCommand}" Margin="0,0,0,12" />
                        <Border Background="{StaticResource JacxiDarkShellBrush}" CornerRadius="10" Padding="14" MinHeight="110">
                            <TextBlock Text="{Binding ToolOutputPreview}" FontFamily="Consolas, Courier New" FontSize="11.5" Foreground="#E5E7EB" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </controls:ResponsiveColumnsPanel>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
