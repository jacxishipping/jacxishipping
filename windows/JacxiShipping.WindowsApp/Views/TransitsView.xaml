<UserControl x:Class="JacxiShipping.WindowsApp.Views.TransitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Cross-Border Transits (UAE / Turkey → Final Destination)" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Manage inland border convoys, customs border crossings, and final delivery proof." FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Origin Port" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewOrigin}" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Final Destination" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewDestination}" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Border Crossing" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewBorder}" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Transit Fee ($)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewCost}" Height="36" />
                </StackPanel>
                <Button Grid.Column="4" Content="+ Create Transit" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding CreateTransitCommand}" VerticalAlignment="Bottom" Height="36" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding Transits}" SelectedItem="{Binding SelectedTransit, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                          Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="REFERENCE" Binding="{Binding ReferenceNumber}" Width="130" />
                        <DataGridTextColumn Header="ORIGIN" Binding="{Binding Origin}" Width="*" />
                        <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}" Width="*" />
                        <DataGridTextColumn Header="BORDER" Binding="{Binding BorderCrossing}" Width="120" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="110" />
                        <DataGridTextColumn Header="COST" Binding="{Binding CostFormatted}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}">
                <StackPanel>
                    <TextBlock Text="TRANSIT &amp; DELIVERY PROOF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding SelectedTransit.ReferenceNumber}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedTransit.CompanyName}" FontSize="12" Foreground="{StaticResource JacxiGoldActiveBrush}" FontWeight="SemiBold" Margin="0,2,0,14" />

                    <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4"><TextBlock Text="Route:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedTransit.Destination}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                            <Grid Margin="0,0,0,4"><TextBlock Text="Border Gate:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedTransit.BorderCrossing}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                            <Grid Margin="0,0,0,4"><TextBlock Text="Status:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedTransit.StatusLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiInfoBrush}" HorizontalAlignment="Right" /></Grid>
                            <Grid><TextBlock Text="Receiver:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedTransit.DeliveryReceiverName, FallbackValue='Pending Handover'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Delivery Receiver Name (for Handover)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding ReceiverName}" Height="36" Margin="0,0,0,12" />
                    <Button Content="Advance Transit Status →" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding AdvanceTransitCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
