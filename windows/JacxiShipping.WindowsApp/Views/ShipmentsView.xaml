<UserControl x:Class="JacxiShipping.WindowsApp.Views.ShipmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             xmlns:converters="clr-namespace:JacxiShipping.WindowsApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1120">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Shipments &amp; Vehicle Inventory"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                <TextBlock Text="Full admin control over auction vehicles, release tokens, invoices, and container assignments."
                           FontSize="13"
                           Foreground="{StaticResource JacxiTextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Export Excel (.xlsx)"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding ExportExcelCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Export CSV"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding ExportManifestCommand}"
                        Margin="0,0,8,0" />
                <Button Content="+ New Shipment"
                        Style="{StaticResource JacxiPrimaryButton}"
                        Command="{Binding ToggleCreatePanelCommand}" />
            </StackPanel>
        </Grid>

        <!-- Collapsible Create Shipment Panel -->
        <Border Grid.Row="1"
                Style="{StaticResource JacxiCardBorder}"
                Visibility="{Binding IsCreatePanelOpen, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="CREATE NEW ADMIN SHIPMENT"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource JacxiGoldActiveBrush}"
                           Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="VIN (17 chars)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewVin, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Year / Make / Model" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource JacxiTextBox}" Text="{Binding NewYear}" Height="36" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource JacxiTextBox}" Text="{Binding NewMake}" Height="36" Margin="0,0,4,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource JacxiTextBox}" Text="{Binding NewModel}" Height="36" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Customer Name" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Total Shipping Price ($)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewFreightPrice, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Auction Yard / Origin" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewAuctionYard}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Destination Port" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewDestinationPort}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <CheckBox Content="Purchase + Shipping" IsChecked="{Binding NewIsPurchaseAndShipping}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="Save Shipment" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding SubmitNewShipmentCommand}" Height="36" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Search & Filters -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource JacxiTextBox}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search tracking, container, VIN, customer..."
                     VerticalContentAlignment="Center"
                     Height="38" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Button Content="All" Style="{StaticResource JacxiOutlineButton}" Command="{Binding FilterAllCommand}" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="In Transit" Style="{StaticResource JacxiOutlineButton}" Command="{Binding FilterInTransitCommand}" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="Customs Hold" Style="{StaticResource JacxiOutlineButton}" Command="{Binding FilterCustomsCommand}" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="Delivered" Style="{StaticResource JacxiOutlineButton}" Command="{Binding FilterDeliveredCommand}" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="Booked" Style="{StaticResource JacxiOutlineButton}" Command="{Binding FilterBookedCommand}" Padding="12,6" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource JacxiSuccessBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Master-Detail -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding FilteredShipments}"
                          SelectedItem="{Binding SelectedShipment, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                          Background="{StaticResource JacxiPanelBrush}"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}"
                          RowStyle="{StaticResource JacxiDataGridRow}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="TRACKING / CONTAINER" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="10,6">
                                        <TextBlock Text="{Binding TrackingNumber}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ContainerNumber}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="VEHICLE / VIN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="6,6">
                                        <TextBlock Text="{Binding Vehicle.FullDescription}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Vehicle.Vin}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CUSTOMER" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="6,6">
                                        <TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DestinationPort}" FontSize="10" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TOTAL" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalCostFormatted}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Admin Inspection & Actions Drawer -->
            <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding SelectedShipment, Converter={StaticResource NullToVis}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedShipment.TrackingNumber}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedShipment.ServiceTypeLabel}" FontSize="11" Foreground="{StaticResource JacxiGoldActiveBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <controls:StatusBadge Grid.Column="1" Status="{Binding SelectedShipment.Status}" />
                        </Grid>

                        <Separator Background="{StaticResource JacxiBorderBrush}" Margin="0,0,0,12" />

                        <!-- Vehicle & Token Specs -->
                        <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="VEHICLE &amp; ADMIN DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding SelectedShipment.Vehicle.FullDescription}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedShipment.Vehicle.Vin, StringFormat='VIN: {0}'}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,3"><TextBlock Text="Customer:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedShipment.CustomerName}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,0,0,3"><TextBlock Text="Payment Status:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedShipment.PaymentStatus}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,0,0,3"><TextBlock Text="Gross Margin:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedShipment.GrossMarginFormatted}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiSuccessBrush}" HorizontalAlignment="Right" /></Grid>
                                <Grid><TextBlock Text="Release Token:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedShipment.ReleaseToken, FallbackValue='Not Issued'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </Border>

                        <!-- Admin Quick Actions -->
                        <TextBlock Text="ADMIN WORKFLOW ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,8" />
                        <Button Content="Advance Next Milestone" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding AdvanceMilestoneCommand}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Generate Invoice" Style="{StaticResource JacxiOutlineButton}" Command="{Binding GenerateInvoiceCommand}" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="Generate BOL" Style="{StaticResource JacxiOutlineButton}" Command="{Binding GenerateBOLCommand}" Margin="4,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Issue Release Token" Style="{StaticResource JacxiOutlineButton}" Command="{Binding IssueReleaseTokenCommand}" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="Request Gate Pass" Style="{StaticResource JacxiOutlineButton}" Command="{Binding RequestGatePassCommand}" Margin="4,0,0,0" />
                        </Grid>

                        <TextBlock Text="MILESTONE TIMELINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,10" />
                        <controls:MilestoneStepper Milestones="{Binding SelectedShipment.Milestones}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
