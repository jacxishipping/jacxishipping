<UserControl x:Class="JacxiShipping.WindowsApp.Views.ShipmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             xmlns:converters="clr-namespace:JacxiShipping.WindowsApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Shipment Inventory &amp; Logistics"
                           FontFamily="{StaticResource JacxiFontFamily}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                <TextBlock Text="Manage container allocations, customs clearance tokens, and vehicle cargo."
                           FontFamily="{StaticResource JacxiFontFamily}"
                           FontSize="13"
                           Foreground="{StaticResource JacxiTextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Export CSV Manifest"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding ExportManifestCommand}"
                        Margin="0,0,12,0" />
            </StackPanel>
        </Grid>

        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <TextBox Grid.Column="0"
                     Style="{StaticResource JacxiTextBox}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Height="40"
                     Tag="Search by tracking, container, VIN, or customer..." />

            <!-- Filter Status Chips -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Button Content="All"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding FilterAllCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="In Transit"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding FilterInTransitCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="Customs Hold"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding FilterCustomsCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="Delivered"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding FilterDeliveredCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="Booked"
                        Style="{StaticResource JacxiOutlineButton}"
                        Command="{Binding FilterBookedCommand}"
                        Padding="14,6" />
            </StackPanel>

            <!-- Feedback Message -->
            <TextBlock Grid.Column="2"
                       Text="{Binding StatusMessage}"
                       FontFamily="{StaticResource JacxiFontFamily}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource JacxiSuccessBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Master-Detail Layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Shipments DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding FilteredShipments}"
                          SelectedItem="{Binding SelectedShipment, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                          Background="{StaticResource JacxiPanelBrush}"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}"
                          RowStyle="{StaticResource JacxiDataGridRow}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- Tracking -->
                        <DataGridTemplateColumn Header="TRACKING / CONTAINER" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="12,6">
                                        <TextBlock Text="{Binding TrackingNumber}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ContainerNumber}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Vehicle -->
                        <DataGridTemplateColumn Header="VEHICLE / VIN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="8,6">
                                        <TextBlock Text="{Binding Vehicle.FullDescription}"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Vehicle.Vin}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Destination -->
                        <DataGridTemplateColumn Header="DESTINATION" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="8,6">
                                        <TextBlock Text="{Binding DestinationPort}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource JacxiTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CustomerName}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="STATUS" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cost -->
                        <DataGridTemplateColumn Header="COST" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalCostFormatted}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource JacxiTextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,14,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: Detail Inspection Drawer -->
            <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding SelectedShipment, Converter={StaticResource NullToVis}}">
                        <!-- Drawer Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedShipment.TrackingNumber}"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedShipment.ContainerNumber}"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                            </StackPanel>

                            <controls:StatusBadge Grid.Column="1" Status="{Binding SelectedShipment.Status}" />
                        </Grid>

                        <Separator Background="{StaticResource JacxiBorderBrush}" Margin="0,0,0,16" />

                        <!-- Vehicle Specs Card -->
                        <Border Background="{StaticResource JacxiBackgroundBrush}"
                                BorderBrush="{StaticResource JacxiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="VEHICLE SPECIFICATIONS"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="{Binding SelectedShipment.Vehicle.FullDescription}"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}"
                                           Margin="0,0,0,4" />

                                <TextBlock Text="{Binding SelectedShipment.Vehicle.Vin, StringFormat='VIN: {0}'}"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Auction Yard:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.Vehicle.AuctionYard}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Lot Number:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.Vehicle.LotNumber}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Title Status:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.Vehicle.TitleStatus}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource JacxiSuccessBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Condition Photos:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.Vehicle.PhotoCount, StringFormat='{}{0} Photos logged'}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Route & Ocean Carrier -->
                        <Border Background="{StaticResource JacxiBackgroundBrush}"
                                BorderBrush="{StaticResource JacxiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CARRIER &amp; ROUTE"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Port of Loading:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.OriginPort}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Port of Discharge:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.DestinationPort}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Vessel / Voyage:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.VesselName}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Estimated Delivery:" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedShipment.EstimatedDelivery}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stepper Section -->
                        <TextBlock Text="MILESTONE PROGRESSION"
                                   FontFamily="{StaticResource JacxiFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                   Margin="0,0,0,12" />

                        <controls:MilestoneStepper Milestones="{Binding SelectedShipment.Milestones}" Margin="0,0,0,16" />

                        <!-- Drawer Action Buttons -->
                        <StackPanel Orientation="Vertical">
                            <Button Content="Advance Next Milestone"
                                    Style="{StaticResource JacxiPrimaryButton}"
                                    Command="{Binding AdvanceMilestoneCommand}"
                                    Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Generate BOL"
                                        Style="{StaticResource JacxiOutlineButton}"
                                        Command="{Binding GenerateBOLCommand}"
                                        Margin="0,0,4,0" />
                                <Button Grid.Column="1"
                                        Content="Mark Delivered"
                                        Style="{StaticResource JacxiOutlineButton}"
                                        Command="{Binding MarkDeliveredCommand}"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
