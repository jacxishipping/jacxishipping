<UserControl x:Class="JacxiShipping.WindowsApp.Views.OperationsBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1120">

    <UserControl.Resources>
        <DataTemplate x:Key="KanbanCardTemplate">
            <Border Background="{StaticResource JacxiPanelBrush}"
                    BorderBrush="{StaticResource JacxiBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{Binding TrackingNumber}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" />
                        <TextBlock Text="{Binding TotalCostFormatted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Vehicle.FullDescription}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Vehicle.Vin}" FontSize="10" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,2,0,4" />
                    <TextBlock Text="{Binding CustomerName}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                    <TextBlock Text="{Binding DestinationPort}" FontSize="10" Foreground="{StaticResource JacxiTextMutedBrush}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />

                    <Button Content="Advance Stage →"
                            Style="{StaticResource JacxiOutlineButton}"
                            Padding="8,4"
                            FontSize="11"
                            Command="{Binding DataContext.AdvanceStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Operations Pipeline Board" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Visual 6-stage vehicle workflow matching online Operations Board. Advance vehicles between stages in real time."
                           FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Refresh Board" Style="{StaticResource JacxiOutlineButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- 6-Column Kanban Grid -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="245" />
                </Grid.ColumnDefinitions>

                <!-- 1. ON HAND -->
                <Border Grid.Column="0" Background="{StaticResource JacxiBorderSubtleBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="1. ON HAND (YARD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OnHandShipments}" ItemTemplate="{StaticResource KanbanCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 2. DISPATCHING -->
                <Border Grid.Column="1" Background="{StaticResource JacxiBorderSubtleBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="2. DISPATCHING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DispatchingShipments}" ItemTemplate="{StaticResource KanbanCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 3. IN TRANSIT -->
                <Border Grid.Column="2" Background="{StaticResource JacxiInfoBgBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="3. OCEAN IN TRANSIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiInfoBrush}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InTransitShipments}" ItemTemplate="{StaticResource KanbanCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 4. RELEASED -->
                <Border Grid.Column="3" Background="{StaticResource JacxiGoldLightBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="4. RELEASED AT PORT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReleasedShipments}" ItemTemplate="{StaticResource KanbanCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 5. IN TRANSIT TO DESTINATION -->
                <Border Grid.Column="4" Background="{StaticResource JacxiWarningBgBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="5. INLAND TRANSIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiWarningBrush}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DestinationTransitShipments}" ItemTemplate="{StaticResource KanbanCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 6. DELIVERED -->
                <Border Grid.Column="5" Background="{StaticResource JacxiSuccessBgBrush}" CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="6. DELIVERED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiSuccessBrush}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DeliveredShipments}" ItemTemplate="{StaticResource KanbanCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
