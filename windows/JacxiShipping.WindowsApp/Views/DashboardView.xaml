<UserControl x:Class="JacxiShipping.WindowsApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1050">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Minimal Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Operations Overview"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                    <TextBlock Text="Shipments, active containers, receivables, and exception alerts."
                               FontSize="12.5"
                               Foreground="{StaticResource JacxiTextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Rate Calculator"
                            Style="{StaticResource JacxiOutlineButton}"
                            Command="{Binding GoToCalculatorCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="All Shipments"
                            Style="{StaticResource JacxiPrimaryButton}"
                            Command="{Binding GoToShipmentsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Responsive 4 -> 2 -> 1 KPI Cards -->
            <controls:ResponsiveColumnsPanel MaxColumns="4" MinColumnWidth="210" ColumnGap="16" RowGap="16" Margin="0,0,0,22">
                <controls:StatsCard Title="ACTIVE SHIPMENTS"
                                    Value="{Binding Stats.ActiveShipmentsCount}"
                                    Subtitle="Yard, ocean &amp; transit" />

                <controls:StatsCard Title="ACTIVE CONTAINERS"
                                    Value="{Binding Stats.ActiveContainersCount}"
                                    Subtitle="Loaded or in transit" />

                <controls:StatsCard Title="PENDING RECEIVABLES"
                                    Value="{Binding Stats.PendingInvoicesFormatted}"
                                    Subtitle="Unpaid &amp; overdue invoices" />

                <controls:StatsCard Title="COLLECTED REVENUE"
                                    Value="{Binding Stats.CollectedRevenueFormatted}"
                                    Subtitle="Settled customer invoices" />
            </controls:ResponsiveColumnsPanel>

            <!-- Responsive 2 -> 1 Middle Section -->
            <controls:ResponsiveColumnsPanel MaxColumns="2" MinColumnWidth="400" ColumnGap="20" RowGap="20" Margin="0,0,0,22">
                <!-- Exceptions Queue -->
                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Action Queue"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="Items requiring review"
                                           FontSize="11.5"
                                           Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                            </StackPanel>
                            <Border Background="{StaticResource JacxiWarningBgBrush}"
                                    BorderBrush="{StaticResource JacxiWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExceptionAlerts.Count, StringFormat='{}{0} Open'}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiWarningBrush}" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ExceptionAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource JacxiBackgroundBrush}"
                                            BorderBrush="{StaticResource JacxiBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Open"
                                                    Style="{StaticResource JacxiOutlineButton}"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    Command="{Binding DataContext.NavigateAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding TargetTab}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Container Utilization -->
                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Container Capacity"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                        <TextBlock Text="Vehicle loading utilization"
                                   FontSize="11.5"
                                   Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                   Margin="0,2,0,14" />

                        <ItemsControl ItemsSource="{Binding ContainerUtilization}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding ContainerNumber}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CapacityDisplay}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource JacxiGoldActiveBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding CurrentCount}"
                                                     Maximum="{Binding MaxCapacity}"
                                                     Height="6"
                                                     Foreground="{StaticResource JacxiGoldBrush}"
                                                     Background="{StaticResource JacxiBorderSubtleBrush}"
                                                     BorderThickness="0" />
                                        <TextBlock Text="{Binding DestinationPort}" FontSize="10.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </controls:ResponsiveColumnsPanel>

            <!-- Recent Shipments Clean List -->
            <Border Style="{StaticResource JacxiCardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Recent Shipments" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="View All →" Style="{StaticResource JacxiGhostButton}" Command="{Binding GoToShipmentsCommand}" HorizontalAlignment="Right" FontSize="12" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentShipments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource JacxiBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TrackingNumber}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ContainerNumber}" FontSize="11" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding Vehicle.FullDescription}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Vehicle.Vin}" FontSize="10.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DestinationPort}" FontSize="10.5" Foreground="{StaticResource JacxiTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <controls:StatusBadge Grid.Column="3" Status="{Binding Status}" />

                                        <TextBlock Grid.Column="4" Text="{Binding TotalCostFormatted}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
