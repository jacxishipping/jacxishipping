<UserControl x:Class="JacxiShipping.WindowsApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Header Section -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Operations Dashboard"
                               FontFamily="{StaticResource JacxiFontFamily}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                    <TextBlock Text="Live vehicle cargo dispatch, ocean line logistics, and customs gateway status."
                               FontFamily="{StaticResource JacxiFontFamily}"
                               FontSize="13"
                               Foreground="{StaticResource JacxiTextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Calculate Rate"
                            Style="{StaticResource JacxiOutlineButton}"
                            Command="{Binding GoToCalculatorCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="+ New Booking"
                            Style="{StaticResource JacxiPrimaryButton}"
                            Command="{Binding GoToCalculatorCommand}" />
                </StackPanel>
            </Grid>

            <!-- 4 Key Metrics Cards -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:StatsCard Grid.Column="0"
                                    Title="TOTAL ACTIVE SHIPMENTS"
                                    Value="{Binding Stats.TotalShipments}"
                                    Subtitle="↑ 12% vs last month" />

                <controls:StatsCard Grid.Column="1"
                                    Title="IN OCEAN TRANSIT"
                                    Value="{Binding Stats.ActiveInTransit}"
                                    Subtitle="5 active vessels en route" />

                <controls:StatsCard Grid.Column="2"
                                    Title="CUSTOMS CLEARANCE"
                                    Value="{Binding Stats.CustomsPending}"
                                    Subtitle="● Awaiting documentation" />

                <controls:StatsCard Grid.Column="3"
                                    Title="DELIVERIES (THIS MONTH)"
                                    Value="{Binding Stats.DeliveredMonth}"
                                    Subtitle="100% on-time release" />
            </Grid>

            <!-- Two-Column Section: Recent Shipments & Operational Status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Recent Shipments Table -->
                <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,24,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recent Shipments"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="Latest containers dispatched from US terminals"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="View All Shipments →"
                                    Style="{StaticResource JacxiGhostButton}"
                                    Command="{Binding GoToShipmentsCommand}" />
                        </Grid>

                        <!-- Shipments List -->
                        <ItemsControl ItemsSource="{Binding RecentShipments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource JacxiBorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tracking & Container -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TrackingNumber}"
                                                           FontFamily="{StaticResource JacxiFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding ContainerNumber}"
                                                           FontFamily="{StaticResource JacxiFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Vehicle & Consignee -->
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock Text="{Binding Vehicle.FullDescription}"
                                                           FontFamily="{StaticResource JacxiFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding CustomerName}"
                                                           FontFamily="{StaticResource JacxiFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Route -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding DestinationPort}"
                                                           FontFamily="{StaticResource JacxiFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding OriginPort}"
                                                           FontFamily="{StaticResource JacxiFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <controls:StatusBadge Grid.Column="3" Status="{Binding Status}" />

                                            <!-- Total -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding TotalCostFormatted}"
                                                       FontFamily="{StaticResource JacxiFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource JacxiTextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Terminal & Line Status -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Port Terminal Status"
                                       FontFamily="{StaticResource JacxiFontFamily}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource JacxiTextPrimaryBrush}"
                                       Margin="0,0,0,14" />

                            <!-- Port 1 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Port of Newark, NJ"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="● Operational"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiSuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Port 2 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Port of Houston, TX"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="● Operational"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiSuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Port 3 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Port of Mersin, Turkey"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="● Normal Gate"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiSuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Port 4 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Jebel Ali Port, UAE"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="● High Volume"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiWarningBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Port 5 -->
                            <Grid>
                                <TextBlock Text="Hairatan Inland Port"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                <TextBlock Text="● Border Open"
                                           FontFamily="{StaticResource JacxiFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource JacxiSuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quick Tracking Banner -->
                    <Border Background="{StaticResource JacxiGoldLightBrush}"
                            BorderBrush="{StaticResource JacxiGoldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource JacxiRadiusCard}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="TRACK CARGO INSTANTLY"
                                       FontFamily="{StaticResource JacxiFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource JacxiGoldActiveBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Look up container or vehicle by VIN across ocean &amp; border milestones."
                                       FontFamily="{StaticResource JacxiFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource JacxiTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14" />
                            <Button Content="Open Live Tracker →"
                                    Style="{StaticResource JacxiPrimaryButton}"
                                    Command="{Binding GoToTrackingCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
