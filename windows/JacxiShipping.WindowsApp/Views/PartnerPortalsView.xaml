<UserControl x:Class="JacxiShipping.WindowsApp.Views.PartnerPortalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1120">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Partner Portals (White-Label B2B)" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Provision branded dealer portals, custom domains, and partner shipment allocations." FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Portal Name" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewName}" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Portal Code" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewCode}" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Custom Domain" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding NewDomain}" Height="36" />
                </StackPanel>
                <Button Grid.Column="3" Content="+ Provision Portal" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding CreatePortalCommand}" VerticalAlignment="Bottom" Height="36" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource JacxiCardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Portals}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                      Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                      ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PORTAL NAME" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="130" />
                    <DataGridTextColumn Header="CUSTOM DOMAIN" Binding="{Binding CustomDomain}" Width="210" />
                    <DataGridTextColumn Header="CUSTOMERS" Binding="{Binding CustomerCount}" Width="95" />
                    <DataGridTextColumn Header="SHIPMENTS" Binding="{Binding AssignedShipmentsCount}" Width="95" />
                    <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceFormatted}" Width="110" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="95" />
                    <DataGridTemplateColumn Header="ACTION" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Toggle Active" Style="{StaticResource JacxiOutlineButton}" Padding="8,4" FontSize="11"
                                        Command="{Binding DataContext.TogglePortalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
