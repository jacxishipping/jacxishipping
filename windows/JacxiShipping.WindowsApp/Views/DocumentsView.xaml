<UserControl x:Class="JacxiShipping.WindowsApp.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:JacxiShipping.WindowsApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Maritime Document Center"
                           FontFamily="{StaticResource JacxiFontFamily}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                <TextBlock Text="Ocean Bills of Lading, Dock Receipts, Port Gate Passes, and Vehicle Inspection Reports."
                           FontFamily="{StaticResource JacxiFontFamily}"
                           FontSize="13"
                           Foreground="{StaticResource JacxiTextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open Last PDF" Style="{StaticResource JacxiOutlineButton}" Command="{Binding OpenExportedFileCommand}" Padding="10,6" Margin="0,0,6,0" />
                <Button Content="Invoice PDF" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ExportInvoicePdfCommand}" Padding="10,6" Margin="0,0,6,0" />
                <Button Content="Release Token PDF" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ExportReleaseTokenPdfCommand}" Padding="10,6" Margin="0,0,6,0" />
                <Button Content="Customs Packet PDF" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ExportCustomsPacketPdfCommand}" Padding="10,6" Margin="0,0,6,0" />
                <Button Content="Statement PDF" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding ExportStatementPdfCommand}" Padding="12,6" />
            </StackPanel>
        </Grid>

        <!-- Two-column: Documents List & Preview Paper -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- Document List -->
            <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,24,0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Documents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ExportTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{StaticResource JacxiBorderSubtleBrush}"
                                        Background="Transparent"
                                        Padding="16,14"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="docBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontFamily="{StaticResource JacxiFontFamily}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding DocumentId}"
                                                                   FontFamily="{StaticResource JacxiFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource JacxiGoldActiveBrush}"
                                                                   Margin="0,2,0,2" />
                                                        <TextBlock Text="{Binding TrackingNumber, StringFormat='Shipment: {0}'}"
                                                                   FontFamily="{StaticResource JacxiFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource JacxiTextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontFamily="{StaticResource JacxiFontFamily}"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource JacxiSuccessBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding FileSize}"
                                                                   FontFamily="{StaticResource JacxiFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="docBorder" Property="Background" Value="{StaticResource JacxiBorderSubtleBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Document Preview Console -->
            <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DOCUMENT INSPECTION VIEWER"
                                   FontFamily="{StaticResource JacxiFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource JacxiTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Print / Export Manifest"
                                Style="{StaticResource JacxiPrimaryButton}"
                                Command="{Binding ExportTextCommand}" />
                    </Grid>

                    <!-- Monospace Document View -->
                    <Border Grid.Row="1"
                            Background="{StaticResource JacxiDarkShellBrush}"
                            BorderBrush="{StaticResource JacxiDarkShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PreviewText}"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     Foreground="#E5E7EB"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="{Binding StatusNotice}"
                               FontFamily="{StaticResource JacxiFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource JacxiSuccessBrush}"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
