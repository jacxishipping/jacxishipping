<UserControl x:Class="JacxiShipping.WindowsApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:JacxiShipping.WindowsApp.Controls"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1120">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Admin Settings &amp; Live Cloud Sync" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Connect this Windows client directly to https://jacxishipping.com or manage local backups and appearance." FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Toggle Light/Dark" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0" />
                    <Button Content="Open Web Portal ↗" Style="{StaticResource JacxiOutlineButton}" Command="{Binding OpenWebPortalCommand}" />
                </StackPanel>
            </Grid>

            <controls:ResponsiveColumnsPanel MaxColumns="2" MinColumnWidth="420" ColumnGap="20" RowGap="20">
                <!-- Cloud Server Connection -->
                <Border Style="{StaticResource JacxiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="JACXI CLOUD API CONNECTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="JACXI Server URL" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding ServerUrl}" Height="38" Margin="0,0,0,12" />

                        <TextBlock Text="Admin Email" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding AdminEmail}" Height="38" Margin="0,0,0,12" />

                        <TextBlock Text="Admin Password" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding AdminPassword}" Height="38" Margin="0,0,0,16" />

                        <Button Content="Authenticate &amp; Sync Live Records" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding ConnectCloudCommand}" Margin="0,0,0,8" />
                        <Button Content="Pull Live Operations from Cloud" Style="{StaticResource JacxiOutlineButton}" Command="{Binding PullCloudSyncCommand}" Margin="0,0,0,12" />

                        <Border Background="{StaticResource JacxiBackgroundBrush}" BorderBrush="{StaticResource JacxiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource JacxiTextPrimaryBrush}" />
                        </Border>

                        <Separator Background="{StaticResource JacxiBorderBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="WINDOWS AUTO-UPDATER (GITHUB RELEASES)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiGoldActiveBrush}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Check Updates" Style="{StaticResource JacxiOutlineButton}" Command="{Binding CheckUpdatesCommand}" Padding="10,5" FontSize="11" />
                        </Grid>

                        <Separator Background="{StaticResource JacxiBorderBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="LOCAL DATABASE CONTROLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Generate JSON Backup" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ExportBackupCommand}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Content="Reset Demo Data" Style="{StaticResource JacxiOutlineButton}" Command="{Binding ResetDemoDataCommand}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- JSON Snapshot Viewer -->
                <Border Style="{StaticResource JacxiCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="420" /></Grid.RowDefinitions>
                        <TextBlock Text="DATABASE SNAPSHOT EXPORT (JSON)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,0,0,10" />
                        <Border Grid.Row="1" Background="{StaticResource JacxiDarkShellBrush}" CornerRadius="8" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding SnapshotPreview}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="#D1D5DB" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </controls:ResponsiveColumnsPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
