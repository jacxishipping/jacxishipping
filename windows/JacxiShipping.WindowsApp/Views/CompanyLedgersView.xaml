<UserControl x:Class="JacxiShipping.WindowsApp.Views.CompanyLedgersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1120">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Company Ledgers &amp; Inter-Ledger Transfers" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Settlement balances across ocean carriers, towing partners, and border transit companies." FontSize="13" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource JacxiSuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Create Transfer Bar -->
            <Border Style="{StaticResource JacxiCardBorder}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Source Party" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding SourceParty}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Destination Party" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding DestParty}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Amount ($)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding TransferAmount}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Reference Note" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource JacxiTextBox}" Text="{Binding Reference}" Height="36" />
                    </StackPanel>
                    <Button Grid.Column="4" Content="Execute Transfer" Style="{StaticResource JacxiPrimaryButton}" Command="{Binding CreateTransferCommand}" VerticalAlignment="Bottom" Height="36" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource JacxiCardBorder}" Margin="0,0,20,0" Padding="0">
                    <StackPanel>
                        <TextBlock Text="SHIPPING / DISPATCH / TRANSIT COMPANIES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="16,14,16,8" />
                        <DataGrid ItemsSource="{Binding Companies}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                                  Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="COMPANY" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="ROLES" Binding="{Binding RolesSummary}" Width="120" />
                                <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceFormatted}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource JacxiCardBorder}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="INTER-LEDGER TRANSFER HISTORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource JacxiTextSecondaryBrush}" Margin="16,14,16,8" />
                        <DataGrid ItemsSource="{Binding Transfers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource JacxiBorderBrush}"
                                  Background="{StaticResource JacxiPanelBrush}" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource JacxiDataGridColumnHeader}" RowStyle="{StaticResource JacxiDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="REF #" Binding="{Binding TransferNumber}" Width="125" />
                                <DataGridTextColumn Header="FROM" Binding="{Binding SourceName}" Width="*" />
                                <DataGridTextColumn Header="TO" Binding="{Binding DestName}" Width="*" />
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountFormatted}" Width="95" />
                                <DataGridTextColumn Header="DATE" Binding="{Binding TransferDate}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
