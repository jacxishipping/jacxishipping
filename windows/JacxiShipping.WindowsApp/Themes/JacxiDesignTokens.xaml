<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- JACXI SHIPPING DESIGN TOKENS (TEAM_DESIGN_SYSTEM_RULES.txt)               -->
    <!-- ========================================================================= -->

    <!-- Core Light Surface Colors -->
    <Color x:Key="JacxiBackgroundRawColor">#F9FAFB</Color>
    <Color x:Key="JacxiPanelRawColor">#FFFFFF</Color>
    <Color x:Key="JacxiBorderRawColor">#E5E7EB</Color>
    <Color x:Key="JacxiBorderSubtleRawColor">#F3F4F6</Color>
    <Color x:Key="JacxiTextPrimaryRawColor">#1C1C1E</Color>
    <Color x:Key="JacxiTextSecondaryRawColor">#5F6368</Color>
    <Color x:Key="JacxiTextMutedRawColor">#9CA3AF</Color>

    <!-- Accent Gold Palette -->
    <Color x:Key="JacxiGoldRawColor">#D4AF37</Color>
    <Color x:Key="JacxiGoldHoverRawColor">#C5A028</Color>
    <Color x:Key="JacxiGoldActiveRawColor">#997C1F</Color>
    <Color x:Key="JacxiGoldLightRawColor">#FEF9E7</Color>
    <Color x:Key="JacxiGoldBorderRawColor">#F3E5AB</Color>

    <!-- Dark Shell / Sidebar Colors -->
    <Color x:Key="JacxiDarkShellRawColor">#111827</Color>
    <Color x:Key="JacxiDarkShellSubtleRawColor">#1F2937</Color>
    <Color x:Key="JacxiDarkShellBorderRawColor">#263143</Color>

    <!-- Semantic / Status Colors -->
    <Color x:Key="JacxiSuccessRawColor">#10B981</Color>
    <Color x:Key="JacxiSuccessBgRawColor">#ECFDF5</Color>
    <Color x:Key="JacxiSuccessBorderRawColor">#A7F3D0</Color>

    <Color x:Key="JacxiWarningRawColor">#F59E0B</Color>
    <Color x:Key="JacxiWarningBgRawColor">#FFFBEB</Color>
    <Color x:Key="JacxiWarningBorderRawColor">#FDE68A</Color>

    <Color x:Key="JacxiErrorRawColor">#EF4444</Color>
    <Color x:Key="JacxiErrorBgRawColor">#FEF2F2</Color>
    <Color x:Key="JacxiErrorBorderRawColor">#FECACA</Color>

    <Color x:Key="JacxiInfoRawColor">#3B82F6</Color>
    <Color x:Key="JacxiInfoBgRawColor">#EFF6FF</Color>
    <Color x:Key="JacxiInfoBorderRawColor">#BFDBFE</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="JacxiBackgroundBrush" Color="{StaticResource JacxiBackgroundRawColor}" />
    <SolidColorBrush x:Key="JacxiPanelBrush" Color="{StaticResource JacxiPanelRawColor}" />
    <SolidColorBrush x:Key="JacxiBorderBrush" Color="{StaticResource JacxiBorderRawColor}" />
    <SolidColorBrush x:Key="JacxiBorderSubtleBrush" Color="{StaticResource JacxiBorderSubtleRawColor}" />
    <SolidColorBrush x:Key="JacxiTextPrimaryBrush" Color="{StaticResource JacxiTextPrimaryRawColor}" />
    <SolidColorBrush x:Key="JacxiTextSecondaryBrush" Color="{StaticResource JacxiTextSecondaryRawColor}" />
    <SolidColorBrush x:Key="JacxiTextMutedBrush" Color="{StaticResource JacxiTextMutedRawColor}" />

    <SolidColorBrush x:Key="JacxiGoldBrush" Color="{StaticResource JacxiGoldRawColor}" />
    <SolidColorBrush x:Key="JacxiGoldHoverBrush" Color="{StaticResource JacxiGoldHoverRawColor}" />
    <SolidColorBrush x:Key="JacxiGoldActiveBrush" Color="{StaticResource JacxiGoldActiveRawColor}" />
    <SolidColorBrush x:Key="JacxiGoldLightBrush" Color="{StaticResource JacxiGoldLightRawColor}" />
    <SolidColorBrush x:Key="JacxiGoldBorderBrush" Color="{StaticResource JacxiGoldBorderRawColor}" />

    <SolidColorBrush x:Key="JacxiDarkShellBrush" Color="{StaticResource JacxiDarkShellRawColor}" />
    <SolidColorBrush x:Key="JacxiDarkShellSubtleBrush" Color="{StaticResource JacxiDarkShellSubtleRawColor}" />
    <SolidColorBrush x:Key="JacxiDarkShellBorderBrush" Color="{StaticResource JacxiDarkShellBorderRawColor}" />

    <SolidColorBrush x:Key="JacxiSuccessBrush" Color="{StaticResource JacxiSuccessRawColor}" />
    <SolidColorBrush x:Key="JacxiSuccessBgBrush" Color="{StaticResource JacxiSuccessBgRawColor}" />
    <SolidColorBrush x:Key="JacxiSuccessBorderBrush" Color="{StaticResource JacxiSuccessBorderRawColor}" />

    <SolidColorBrush x:Key="JacxiWarningBrush" Color="{StaticResource JacxiWarningRawColor}" />
    <SolidColorBrush x:Key="JacxiWarningBgBrush" Color="{StaticResource JacxiWarningBgRawColor}" />
    <SolidColorBrush x:Key="JacxiWarningBorderBrush" Color="{StaticResource JacxiWarningBorderRawColor}" />

    <SolidColorBrush x:Key="JacxiErrorBrush" Color="{StaticResource JacxiErrorRawColor}" />
    <SolidColorBrush x:Key="JacxiErrorBgBrush" Color="{StaticResource JacxiErrorBgRawColor}" />
    <SolidColorBrush x:Key="JacxiErrorBorderBrush" Color="{StaticResource JacxiErrorBorderRawColor}" />

    <SolidColorBrush x:Key="JacxiInfoBrush" Color="{StaticResource JacxiInfoRawColor}" />
    <SolidColorBrush x:Key="JacxiInfoBgBrush" Color="{StaticResource JacxiInfoBgRawColor}" />
    <SolidColorBrush x:Key="JacxiInfoBorderBrush" Color="{StaticResource JacxiInfoBorderRawColor}" />

    <!-- Corner Radii -->
    <CornerRadius x:Key="JacxiRadiusControl">8</CornerRadius>
    <CornerRadius x:Key="JacxiRadiusPanel">12</CornerRadius>
    <CornerRadius x:Key="JacxiRadiusCard">14</CornerRadius>
    <CornerRadius x:Key="JacxiRadiusWindow">16</CornerRadius>
    <CornerRadius x:Key="JacxiRadiusPill">999</CornerRadius>

    <!-- Typography -->
    <FontFamily x:Key="JacxiFontFamily">Segoe UI Variable Display, Segoe UI, Inter, Arial, sans-serif</FontFamily>

    <!-- Soft Minimalist Shadows -->
    <DropShadowEffect x:Key="JacxiSoftShadow"
                      BlurRadius="14"
                      Direction="270"
                      Opacity="0.035"
                      ShadowDepth="2"
                      Color="#0F172A" />

    <DropShadowEffect x:Key="JacxiCardShadow"
                      BlurRadius="24"
                      Direction="270"
                      Opacity="0.08"
                      ShadowDepth="4"
                      Color="#0F172A" />

    <DropShadowEffect x:Key="JacxiGoldGlow"
                      BlurRadius="10"
                      Direction="0"
                      Opacity="0.25"
                      ShadowDepth="0"
                      Color="{StaticResource JacxiGoldRawColor}" />

